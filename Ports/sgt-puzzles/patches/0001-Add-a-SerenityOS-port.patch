diff --git a/cmake/platforms/serenity.cmake b/cmake/platforms/serenity.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..e74b137b0a599f0cf1bd699277428ac93a8d286a
--- /dev/null
+++ b/cmake/platforms/serenity.cmake
@@ -0,0 +1,32 @@
+string(APPEND CMAKE_CXX_FLAGS " -std=c++26 -fno-exceptions")
+
+# Serenity's <tgmath.h> lacks the standard csqrt family, use <math.h> instead
+add_compile_definitions(NO_TGMATH_H)
+
+set(platform_common_sources serenity.cpp printing.c)
+set(platform_gui_libs -lgui -lgfx)
+set(platform_libs -lcore -lcorebasic -lcoreminimal -lmain)
+
+# Icons are generated on the host since they require running the built games
+set(build_icons FALSE)
+set(build_cli_programs FALSE)
+set(build_gui_programs FALSE)
+
+function(set_platform_gui_target_properties TARGET)
+endfunction()
+
+function(get_platform_puzzle_extra_source_files OUTVAR NAME AUXILIARY)
+  # Serenity doesn't use the generated XPM icons, so just use the
+  # no-icon stub for all puzzles.
+  set(${OUTVAR} ${PUZZLES_ROOT_DIR}/no-icon.c PARENT_SCOPE)
+endfunction()
+
+function(set_platform_puzzle_target_properties NAME TARGET)
+  get_target_property(official ${TARGET} official)
+  if(official)
+    install(TARGETS ${TARGET})
+  endif()
+endfunction()
+
+function(build_platform_extras)
+endfunction()
