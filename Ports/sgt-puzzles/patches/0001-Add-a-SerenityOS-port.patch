---
 CMakeLists.txt                 |   4 +-
 cmake/platforms/serenity.cmake |  32 ++
 cmake/setup.cmake              |   2 +
 puzzles.h                      |   8 +
 serenity.cpp                   | 555 +++++++++++++++++++++++++++++++++
 5 files changed, 599 insertions(+), 2 deletions(-)
 create mode 100644 cmake/platforms/serenity.cmake
 create mode 100644 serenity.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9011df7b185e8be8eac41ba9fc1f3af5f476cfa8..c8d6f985b993c788c2c0b12220d96a48d74652e9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,7 +1,7 @@
-cmake_minimum_required(VERSION 3.5)
+cmake_minimum_required(VERSION 3.25)
 
 project(puzzles
-  LANGUAGES C)
