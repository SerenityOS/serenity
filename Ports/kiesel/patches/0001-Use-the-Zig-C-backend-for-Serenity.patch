diff --git a/build.zig b/build.zig
index 137ebdc05a00b7dcb2ffe100a4dff86eaee86a27..0ab2d09ad497ce94c4a17c71a0cd255fd919bb3b 100644
--- a/build.zig
+++ b/build.zig
@@ -6,8 +6,10 @@ const manifest = @import("build.zig.zon");
 const kiesel_version = std.SemanticVersion.parse(manifest.version) catch unreachable;
 
 pub fn build(b: *std.Build) !void {
-    const target = b.standardTargetOptions(.{});
+    var target = b.standardTargetOptions(.{});
     const optimize = b.standardOptimizeOption(.{});
+    target.query.ofmt = .c;
