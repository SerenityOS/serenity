From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Linus Groh <mail@linusgroh.de>
Date: Sat, 24 Oct 2026 18:31:06 +0100
Subject: [PATCH] Fix black screen with 16-bit SDL textures

CopyBitsToTexture calculated row padding as pitch - width * 4, assuming
every texture pixel is 4 bytes. SDL's software renderer gives OpenRCT2 an
RGB565 texture instead, where each pixel is 2 bytes, so the padding was
negative and none of the copy loops matched. The texture stayed empty and
the window was black.

The 16-bit copy loop also read two palette indices per output pixel. It was
never reached because of the padding bug, but it would have produced a
corrupted image.

Calculate padding from the texture format's actual bytes per pixel and write
one mapped palette color per pixel.

---
--- a/src/openrct2-ui/drawing/engines/HardwareDisplayDrawingEngine.cpp
+++ b/src/openrct2-ui/drawing/engines/HardwareDisplayDrawingEngine.cpp
@@ -13,6 +13,7 @@
 #include <SDL_render.h>
 #include <SDL_version.h>
 #include <cmath>
+#include <cstring>
 #include <memory>
 #include <openrct2/Diagnostic.h>
 #include <openrct2/Game.h>
@@ -278,48 +279,26 @@
     {
         void* pixels;
         int32_t pitch;
-        if (SDL_LockTexture(texture, nullptr, &pixels, &pitch) == 0)
+        if (SDL_LockTexture(texture, nullptr, &pixels, &pitch) != 0)
         {
-            int32_t padding = pitch - (width * 4);
-            if (pitch == width * 4)
-            {
-                uint32_t* dst = static_cast<uint32_t*>(pixels);
-                for (int32_t i = width * height; i > 0; i--)
-                {
-                    *dst++ = palette[EnumValue(*src++)];
-                }
-            }
-            else
+            return;
+        }
+
+        const int32_t bytesPerPixel = _screenTextureFormat->BytesPerPixel;
+        const int32_t padding = pitch - (width * bytesPerPixel);
+        auto* dst = static_cast<uint8_t*>(pixels);
+        for (int32_t y = 0; y < height; y++)
+        {
+            for (int32_t x = 0; x < width; x++)
             {
-                if (pitch == (width * 2) + padding)
-                {
-                    uint16_t* dst = static_cast<uint16_t*>(pixels);
-                    for (int32_t y = height; y > 0; y--)
-                    {
-                        for (int32_t x = width; x > 0; x--)
-                        {
-                            const uint8_t lower = *reinterpret_cast<const uint8_t*>(&palette[EnumValue(*src++)]);
-                            const uint8_t upper = *reinterpret_cast<const uint8_t*>(&palette[EnumValue(*src++)]);
-                            *dst++ = (lower << 8) | upper;
-                        }
-                        dst = reinterpret_cast<uint16_t*>(reinterpret_cast<uint8_t*>(dst) + padding);
-                    }
-                }
-                else if (pitch == width + padding)
-                {
-                    uint8_t* dst = static_cast<uint8_t*>(pixels);
-                    for (int32_t y = height; y > 0; y--)
-                    {
-                        for (int32_t x = width; x > 0; x--)
-                        {
-                            *dst++ = *reinterpret_cast<const uint8_t*>(&palette[EnumValue(*src++)]);
-                        }
-                        dst += padding;
-                    }
-                }
+                const uint32_t pixel = palette[EnumValue(*src++)];
+                std::memcpy(dst, &pixel, bytesPerPixel);
+                dst += bytesPerPixel;
             }
-            SDL_UnlockTexture(texture);
+            dst += padding;
         }
+
+        SDL_UnlockTexture(texture);
     }
 
     uint32_t GetDirtyVisualTime(uint32_t x, uint32_t y)
