From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brian Callahan <bcallah@openbsd.org>
Date: Thu, 23 Jan 2020 23:43:31 -0500
Subject: [PATCH] Don't use libc's regex

---
 configure | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/configure b/configure
index 9bdd6bec3b5f422fd89fc78c9787feac4bfd48bb..2d81d05971f7a6713ea5d16695feec5d18660fa4 100755
--- a/configure
+++ b/configure
@@ -22435,7 +22435,7 @@ fi
 
 # checks for headers
 
-       for ac_header in regex.h strings.h sys/wait.h unistd.h
+       for ac_header in pcre2posix.h strings.h sys/wait.h unistd.h
 do :
   as_ac_Header=`printf "%s\n" "ac_cv_header_$ac_header" | $as_tr_sh`
 ac_fn_c_check_header_compile "$LINENO" "$ac_header" "$as_ac_Header" "$ac_includes_default"
@@ -23394,7 +23394,7 @@ fi
 
 
 
-  for ac_func in dup2 memset regcomp strcasecmp strchr strdup strtol
+  for ac_func in dup2 memset strcasecmp strchr strdup strtol
 do :
   as_ac_var=`printf "%s\n" "ac_cv_func_$ac_func" | $as_tr_sh`
 ac_fn_c_check_func "$LINENO" "$ac_func" "$as_ac_var"
