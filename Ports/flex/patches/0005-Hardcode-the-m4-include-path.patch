From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brian Callahan <bcallah@openbsd.org>
Date: Thu, 23 Jan 2020 23:43:31 -0500
Subject: [PATCH] Hardcode the m4 include path

---
 src/Makefile.in | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Makefile.in b/src/Makefile.in
index 9c199292a1f1400936b6763dd096e34829db3acd..700967a07cfba8800d38c17ec57ef672bb94bd7e 100644
--- a/src/Makefile.in
+++ b/src/Makefile.in
@@ -393,7 +393,7 @@ LTLIBICONV = @LTLIBICONV@
 LTLIBINTL = @LTLIBINTL@
 LTLIBOBJS = @LTLIBOBJS@
 LT_SYS_LIBRARY_PATH = @LT_SYS_LIBRARY_PATH@
-M4 = @M4@
+M4 = /usr/local/bin/m4
 MAKEINFO = @MAKEINFO@
 MANIFEST_TOOL = @MANIFEST_TOOL@
 MKDIR_P = @MKDIR_P@
@@ -491,7 +491,7 @@ top_srcdir = @top_srcdir@
 AM_YFLAGS = -d
 AM_CPPFLAGS = -DLOCALEDIR=\"$(localedir)\"
 AM_CFLAGS = $(WARNINGFLAGS)
-m4 = @M4@
+m4 = m4
 @CROSS_FALSE@@ENABLE_BOOTSTRAP_TRUE@noinst_DATA = stage2compare
 @ENABLE_LIBFL_TRUE@lib_LTLIBRARIES = libfl.la
 @ENABLE_LIBFL_TRUE@pkgconfig_DATA = libfl.pc
