From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jelle Raaijmakers <jelle@gmta.nl>
Date: Tue, 29 Mar 2022 22:41:26 +0200
Subject: [PATCH] Build: Disable `pharcmd`

We do not support running the PHP binary locally after its build, so do
not try to run phar locally.
---
 configure.ac | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/configure.ac b/configure.ac
index 6b948167d4273d99b9f7e348133f68d291185d93..3aad6abc55fb6eb6f550ea1537c54248e3ca5838 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1614,8 +1614,8 @@ CFLAGS="\$(CFLAGS_CLEAN) $standard_libtool_flag"
 CXXFLAGS="$CXXFLAGS $standard_libtool_flag \$(PROF_FLAGS)"
 
 if test "$PHP_PHAR" != "no" && test "$PHP_CLI" != "no"; then
-  pharcmd=pharcmd
-  pharcmd_install=install-pharcmd
+  pharcmd=
+  pharcmd_install=
 else
   pharcmd=
   pharcmd_install=
