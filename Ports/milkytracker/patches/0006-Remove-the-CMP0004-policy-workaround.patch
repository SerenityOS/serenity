From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Linus Groh <mail@linusgroh.de>
Date: Thu, 15 Oct 2026 09:23:47 +0200
Subject: [PATCH] Remove the CMP0004 policy workaround

---
 CMakeLists.txt | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index aac86dbfb5030c0156e03ca4b954ebabdeb2eb03..3ab48d4dd2376ee0ba35f38cc6be6c3bf94e74f6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -162,10 +162,6 @@ elseif(HAIKU)
     message(STATUS "Enabled MIDI support (Haiku)")
     add_subdirectory(src/midi)
 else()
-    # Workaround for SDL bug #3295, which occurs in SDL2 <2.0.5
-    # https://bugzilla.libsdl.org/show_bug.cgi?id=3295
-    cmake_policy(SET CMP0004 OLD)
-
     find_package(SDL2 REQUIRED)
 endif()
 
